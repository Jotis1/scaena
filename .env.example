# Copia este fichero a .env y rellénalo. El servidor no arranca si falta alguna variable (lib/env.ts).

# Twitch: https://dev.twitch.tv/console/apps
# Redirección: <BETTER_AUTH_URL>/api/auth/callback/twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Secreto de los webhooks de EventSub: entre 10 y 100 caracteres ASCII.
TWITCH_EVENTSUB_SECRET=

# YouTube Data API v3: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Upstash Redis (Marketplace de Vercel): eventos, cachés, token de overlay y ajustes del canal.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# better-auth. El secreto, con `bunx @better-auth/cli secret` (al menos 32 caracteres).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Postgres. En local, con `bunx prisma dev --name scaena --db-port 51214 --shadow-db-port 51215 --detach`;
# en Vercel, la de Neon.
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Solo en local: la base auxiliar de `prisma migrate dev`. En Vercel no hace falta.
SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:51215/template1?sslmode=disable

# Ids de Twitch (solo cifras, separados por comas) que pueden entrar en el estudio. Hoy, el de jotis1.
STUDIO_ALLOWED_TWITCH_IDS=

{
	"name": "scaena",
	"version": "0.0.0",
	"private": true,
	"description": "Overlays de OBS, estudio y web del canal de la suite jotis.me",
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.3",
	"scripts": {
		"postinstall": "prisma generate",
		"dev": "next dev",
		"build": "bun run validate-profile && next build",
		"vercel-build": "prisma migrate deploy && bun run build",
		"validate-profile": "bun run scripts/validate-profile.ts",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"check:colors": "bun run scripts/check-colors.ts app components lib",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"ci": "biome ci . && bun run check:colors && tsc --noEmit && vitest run && bun run build"
	},
	"dependencies": {
		"@jotis-me/icons": "^0.2.0",
		"@jotis-me/react": "^0.2.0",
		"@prisma/adapter-neon": "^7.10.1",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@upstash/redis": "^1.41.0",
		"better-auth": "^1.7.17",
		"fflate": "^0.8.3",
		"modern-screenshot": "^4.7.0",
		"next": "^16.4.5",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "^2.6.5",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4.3.4",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/pngjs": "^6.0.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/ws": "^8.18.2",
		"@vitejs/plugin-react": "^6.2.1",
		"dotenv": "^18.0.9",
		"jsdom": "^30.1.3",
		"pixelmatch": "^8.0.0",
		"pngjs": "^7.0.0",
		"prisma": "^7.10.1",
		"tailwindcss": "^4.3.4",
		"typescript": "^6",
		"vitest": "^5.1.0",
		"ws": "^8.22.1"
	}
}
